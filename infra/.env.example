# Copy to .env and fill in. Never commit .env. Values below are placeholders, not secrets.
POSTGRES_DB=mpcalc
POSTGRES_USER=mpcalc
POSTGRES_PASSWORD=change-me
# API key the chat service sends to the backend's MCP server (generate a long random string)
MCP_API_KEY=change-me
# Claude API key (used only by the chat service)
ANTHROPIC_API_KEY=your-claude-api-key-here
# Claude model of the chat (default claude-haiku-5-5; claude-sonnet-5-5 or claude-opus-5-5 are one setting away)
# CHAT_MODEL=claude-haiku-5-5
# Per-player chat limits (defaults: 10 questions per 300 seconds, 2 at the same time)
# CHAT_RATE_QUESTIONS=10
# CHAT_RATE_WINDOW_SECONDS=300
# CHAT_RATE_CONCURRENT=2
# Host port of the proxy
PROXY_PORT=8081
# Folder with the compiled Angular files (default ./site, relative to infra/)
# FRONTEND_DIST=../frontend/dist/frontend/browser   (output of `ng build` in frontend/)
